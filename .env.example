PORT=8089
NODE_ENV=development
LOG_LEVEL=info

# userservice's OWN database - patient profiles, family members and medical
# records. Never authservice's.
DATABASE_URL="postgresql://userservice:userservice@localhost:5432/userservice"

# Same value as the api-gateway's USER_GATEWAY_SECRET (min 32 chars). Required
# when NODE_ENV=production. Unset = x-user-id / x-user-role are trusted from
# anyone - development only.
GATEWAY_SECRET=

# Producing services that may POST /internal/v1/health-records, each with its
# own token (32+ chars; openssl rand -hex 32). A token writes only its source.
#   labscan:<token>,ecg:<token>,hospital:<token>,homebasedcare:<token>,ambulance:<token>
INTERNAL_SERVICE_TOKENS=

# Kafka: health-records.events is consumed when KAFKA_BROKERS is set.
KAFKA_BROKERS=
# KAFKA_CLIENT_ID=userservice
# KAFKA_GROUP_ID=userservice
# HEALTH_RECORDS_TOPIC=health-records.events

# ABDM - ABHA linking and sharing records as a Health Information Provider.
# Off unless all three are set. Same client as pro; HIP id = our HFR facility id.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
# ABDM_HIP_NAME=Uyir
# Sandbox defaults:
# ABDM_GATEWAY_URL=https://dev.abdm.gov.in
# ABDM_ABHA_URL=https://abhasbx.abdm.gov.in
# ABDM_CM_ID=sbx
# ABDM_CERTS_URL=            (default <gateway>/api/hiecm/gateway/v3/certs)
# ABDM_VERIFY_CALLBACKS=off  (local only - refused in production)
# ABDM_WORKER_INTERVAL_MS=5000

# Privacy (DPDP Act) - see docs/privacy.md.
# AES-256 key for health-record files at rest (openssl rand -base64 32).
# Required when NODE_ENV=production; files can't be read without it.
DATA_ENCRYPTION_KEY=
# The notice patients consent to. Bump the version when the notice changes -
# every patient is asked to consent again.
PRIVACY_NOTICE_VERSION=1
PRIVACY_NOTICE_URL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
# Retention windows in days (defaults shown). Audit >= 365.
# RETENTION_REJECTIONS_DAYS=30
# RETENTION_ABDM_DAYS=30
# RETENTION_ORPHAN_RECORDS_DAYS=365
# RETENTION_AUDIT_DAYS=1095

# Only for the one-off `npm run import:authservice` (read-only).
AUTH_DATABASE_URL=
