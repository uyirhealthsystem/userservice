# Copy to /opt/userservice/shared/userservice.env on the EC2 host and fill in.
# chmod 640, owned by <deploy user>:userservice. NEVER commit the real file.

NODE_ENV=production
PORT=8089
LOG_LEVEL=info

# userservice's OWN database (RDS endpoint, or local Postgres). Never
# authservice's. The user must be able to run migrations (DDL).
DATABASE_URL="postgresql://userservice:CHANGE_ME@your-db-host:5432/userservice?schema=public"
# Neon: DATABASE_URL = the "-pooler" host, DIRECT_DATABASE_URL = the same string
# without "-pooler". Migrations run over the direct one (remote-release.sh).
# Leave empty for RDS / plain Postgres.
DIRECT_DATABASE_URL=

# REQUIRED in production. Same value as the api-gateway's USER_GATEWAY_SECRET
# (32+ chars).
GATEWAY_SECRET=

# REQUIRED in production. AES-256 key for health-record files at rest
# (openssl rand -base64 32). Losing it makes stored files unreadable - back it
# up somewhere safe (e.g. AWS Secrets Manager).
DATA_ENCRYPTION_KEY=

# Kafka: health-records.events is consumed when KAFKA_BROKERS is set. Use the
# SAME cluster as the producers.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=userservice
KAFKA_GROUP_ID=userservice
# HEALTH_RECORDS_TOPIC=health-records.events

# ABDM - off unless all three are set. Production gateway URLs differ from the
# sandbox defaults; set ABDM_GATEWAY_URL / ABDM_ABHA_URL / ABDM_CM_ID once
# you're approved for production.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=
# ABDM_HIP_NAME=Uyir
# ABDM_GATEWAY_URL=https://dev.abdm.gov.in
# ABDM_ABHA_URL=https://abhasbx.abdm.gov.in
# ABDM_CM_ID=sbx

# Privacy (DPDP Act) - see docs/privacy.md.
PRIVACY_NOTICE_VERSION=1
PRIVACY_NOTICE_URL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
